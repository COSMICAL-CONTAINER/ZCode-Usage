{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/skills/zcode-usage/scripts/widget-launch.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "确保 GLM 用量悬浮窗在运行(按设备选择 UI)"
          },
          {
            "type": "command",
            "command": "node \"${ZCODE_PLUGIN_ROOT}/skills/zcode-usage/scripts/zcode-usage.mjs\" --hook",
            "timeoutMs": 8000,
            "statusMessage": "注入 GLM Coding Plan 用量摘要"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/skills/zcode-usage/scripts/quota-guard.mjs", "--event", "UserPromptSubmit"],
            "timeoutMs": 5000,
            "statusMessage": "额度阈值检查(quota-guard)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/skills/zcode-usage/scripts/quota-guard.mjs", "--event", "Stop"],
            "timeoutMs": 5000,
            "statusMessage": "额度收尾检查(quota-guard)"
          }
        ]
      }
    ]
  }
}
